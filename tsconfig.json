{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "skipLibCheck": true, "allowJs": true, "checkJs": false, "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "cli/**/*.ts"]
}
